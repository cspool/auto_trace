# Runtime evidence is large, host-specific, and regenerated by the scheduler.
/runtime/

# Bulk NFS trace databases, exports, and compiler caches stay outside Git.
# Keep curated evidence in releases/ and large payloads in release assets.
/runtime_nfs_bulk/

# Raw Codex/app-server transport logs are diagnostic state, not migration products.
**/app_server.jsonl
**/app_server.stderr.log

# Generated interpreter/editor caches.
**/__pycache__/
*.py[cod]
*.swp
*~
